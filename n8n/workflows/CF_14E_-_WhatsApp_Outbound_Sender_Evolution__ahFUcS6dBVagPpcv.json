      "parameters": {},
      "id": "ea7c7bc4-a4ef-45d1-a87a-1f55a4507328",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -720,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const envelope = $input.first().json;\nconst outbound = envelope._outbound;\nconst to       = envelope.user?.wa_number;\nconst instance = envelope.tenant?.evo_instance_name ?? $vars?.CF_EVO_INSTANCE;\n\nif (!outbound?.body) return [{ json: { ...envelope, _skip: true } }];\n\n// Evolution con Baileys NO soporta botones nativos.\n// Convertimos todo a texto formateado con opciones numeradas.\nfunction buildTextFromButtons(body, buttons) {\n  if (!buttons || buttons.length === 0) return body;\n  const opts = buttons.map((b, i) => `${i + 1}. ${b.title}`).join('\\n');\n  return `${body}\\n\\n${opts}`;\n}\n\nfunction buildTextFromList(body, list) {\n  if (!list?.sections) return body;\n  let text = body + '\\n';\n  for (const section of list.sections) {\n    if (section.title) text += `\\n*${section.title}*\\n`;\n    for (const row of section.rows) {\n      text += `• ${row.title}`;\n      if (row.description) text += ` — ${row.description}`;\n      text += '\\n';\n    }\n  }\n  text += '\\n_Responde con el número o nombre de la opción que deseas._';\n  return text;\n}\n\nlet finalText = '';\n\nswitch (outbound.type) {\n  case 'text':\n    finalText = outbound.body;\n    break;\n  case 'buttons':\n    finalText = buildTextFromButtons(outbound.body, outbound.buttons);\n    break;\n  case 'list':\n    finalText = buildTextFromList(outbound.body, outbound.list);\n    break;\n  default:\n    finalText = outbound.body;\n}\n\nconst endpoint = `/message/sendText/${instance}`;\nconst payload  = { number: to, text: finalText };\n\nreturn [{ json: { ...envelope, _skip: false, _endpoint: endpoint, _payload: payload } }];"
      },
