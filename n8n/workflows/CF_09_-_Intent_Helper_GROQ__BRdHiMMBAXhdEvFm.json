    {
      "parameters": {
        "jsCode": "// ── CF-09 · Build GROQ Prompt ────────────────────────────────────────\nconst envelope   = $input.first().json;\nconst msgText    = String(envelope.message?.text ?? '').trim();\nconst clinicName = envelope.tenant?.name ?? 'la clínica';\nconst step       = envelope.session?.current_step ?? 'idle';\n\nlet sessionHint = '';\nif (step !== 'idle') {\n  sessionHint = `\\nNota: el usuario está en el paso de sesión \"${step}\".`;\n}\n\nconst systemPrompt =\n  `Eres un clasificador de intenciones para el bot de WhatsApp de \"${clinicName}\".\\n` +\n  `Clasifica el mensaje del usuario en UNA de estas intenciones.${sessionHint}\\n\\n` +\n  `Intenciones disponibles:\\n` +\n  `- booking: agendar, reservar o pedir una cita nueva\\n` +\n  `- catalog: SOLO cuando el usuario pregunta EXPLÍCITAMENTE por servicios, precios o tratamientos disponibles\\n` +\n  `- cancel: cancelar una cita existente\\n` +\n  `- reschedule: reprogramar, cambiar o mover una cita existente\\n` +\n  `- faq: preguntas médicas (dolor, síntomas, medicamentos, si puede tomar algo), ` +\n  `horarios, ubicación, formas de pago, información general, cualquier pregunta que no sea agendar\\n` +\n  `- greeting: saludo sin intención específica (hola, buenos días, gracias, etc.)\\n` +\n  `- other: no encaja claramente en ninguna categoría anterior\\n\\n` +\n  `REGLAS CRÍTICAS DE CLASIFICACIÓN:\\n` +\n  `1. Dolor, síntomas, medicamentos, preguntas de salud → SIEMPRE \"faq\"\\n` +\n  `2. Un número solo sin contexto (1, 2, 3, etc.) → SIEMPRE \"faq\"\\n` +\n  `3. \"catalog\" es ÚNICAMENTE para \"¿qué servicios tienen?\" o \"¿cuánto cuesta X?\"\\n` +\n  `4. Mencionar una parte del cuerpo (muela, espalda, cabeza) NO es \"catalog\"\\n` +\n  `5. Si hay duda entre catalog y faq → elige \"faq\"\\n\\n` +\n  `Responde ÚNICAMENTE con JSON válido, sin texto adicional, sin backticks:\\n` +\n  `{\"intent\": \"<intent>\", \"confidence\": <número entre 0.0 y 1.0>}`;\n\nreturn [{\n  json: {\n    ...envelope,\n    _groq_messages: [\n      { role: 'system', content: systemPrompt },\n      { role: 'user',   content: msgText || '(mensaje sin texto)' }\n    ]\n  }\n}];"
      },
      "id": "1c9ff925-e724-4011-b323-1ecadaba2220",
      "name": "Build GROQ Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        224
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{REDACTED:GROQ_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  model: 'llama-3.1-8b-instant',\n  messages: $json._groq_messages,\n  max_tokens: 150,\n  temperature: 0.1,\n  response_format: { type: 'json_object' }\n}) }}",
        "options": {}
      },
      "id": "ef874902-ac14-48b8-9810-855921d56284",
      "name": "GROQ — Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -720,
        224
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "9hRusUHDOrecGhUs",
          "name": "Header Auth account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// ── CF-09 · Parse & Route Intent ────────────────────────────────────\n// Parsea la respuesta de GROQ y convierte la intención en una _route\n// compatible con el resto del sistema ClinicFlow.\n\nconst envelope  = $('Build GROQ Prompt').item.json;\nconst groqResp  = $input.first().json;\n\n// ── 1. Extraer texto de la respuesta GROQ ──────────────────────────\nlet intent     = 'other';\nlet confidence = 0;\n\ntry {\n  const content = groqResp?.choices?.[0]?.message?.content ?? '';\n  const cleaned = content.replace(/```json|```/g, '').trim();\n  const parsed  = JSON.parse(cleaned);\n  intent     = String(parsed?.intent ?? 'other').toLowerCase().trim();\n  confidence = Number(parsed?.confidence ?? 0);\n} catch (e) {\n  // GROQ no disponible o respuesta no parseable → defecto: faq\n  intent     = 'faq';\n  confidence = 0;\n}\n\n// ── 2. Validar que la intención sea una conocida ───────────────────\nconst validIntents = ['booking', 'catalog', 'cancel', 'reschedule', 'faq', 'greeting', 'other'];\nif (!validIntents.includes(intent)) intent = 'other';\n\n// ── 3. Mapear intención → _route y campos extra ──────────────────\nlet route   = 'faq';\nlet crExtra = {};\n\nswitch (intent) {\n  case 'booking':\n  case 'catalog':\n    route = 'catalog_engine';\n    break;\n  case 'cancel':\n    route   = 'cancel_reschedule';\n    crExtra = { _cr_action: 'cancel_lookup' };\n    break;\n  case 'reschedule':\n    route   = 'cancel_reschedule';\n    crExtra = { _cr_action: 'reschedule_lookup' };\n    break;\n  case 'greeting':\n    route = 'greeting';\n    break;\n  case 'faq':\n  case 'other':\n  default:\n    route = 'faq';\n    break;\n}\n\nreturn [{\n  json: {\n    ...envelope,\n    ...crExtra,\n    _route:              route,\n    _intent:             intent,\n    _intent_confidence:  confidence,\n    routing: {\n      intent,\n      confidence,\n      source: 'groq-intent-09'\n    }\n  }\n}];"
      },
