    {
      "parameters": {
        "jsCode": "// Saludos: construir menú de bienvenida igual que el Router\nconst e       = $input.first().json;\nconst name    = e.user?.wa_name ?? '';\nconst clinic  = e.tenant?.name  ?? 'nuestra clínica';\nconst welcome = e.tenant?.settings?.welcome_message;\nconst body    = welcome ?? `👋 ¡Hola${name ? ' ' + name : ''}! Bienvenido/a a *${clinic}*.\\n\\n¿En qué puedo ayudarte hoy?`;\n\nreturn [{\n  json: {\n    ...e,\n    _outbound: {\n      type: 'text',\n      body: body + '\\n\\n1. 📅 Agendar cita\\n2. 🦷 Ver servicios\\n3. ❓ Preguntas frecuentes\\n\\n_Responde con el número o escribe tu opción._'\n    }\n  }\n}];"
      },
