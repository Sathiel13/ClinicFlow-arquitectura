    {
      "parameters": {
        "jsCode": "// PostgREST con return=representation devuelve array\n// Extraemos user_id y lo mergeamos con el envelope original\nconst envelope = $('Execute Workflow Trigger').item.json;\nconst raw      = $input.first().json;\nconst user     = Array.isArray(raw) ? raw[0] : raw;\n\nreturn [{\n  json: {\n    ...envelope,\n    user: {\n      ...envelope.user,\n      user_id: user.id\n    },\n    _user_row: user\n  }\n}];"
      },
