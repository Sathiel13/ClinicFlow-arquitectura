    {
      "parameters": {
        "jsCode": "const envelope = $('Recover session + Enrich Envelope').item.json;\nconst raw      = $input.first().json;\nconst row      = Array.isArray(raw) ? raw[0] : (raw?.id ? raw : null);\n\nconst lastInteraction = row?.last_interaction_at ?? new Date().toISOString();\n\nreturn [{\n  json: {\n    ...envelope,\n    patient: {\n      active_patient_id: envelope.session.active_patient_id ?? null\n    },\n    session: {\n      ...envelope.session,\n      last_interaction_at: lastInteraction\n    },\n    _user_row: undefined\n  }\n}];"
