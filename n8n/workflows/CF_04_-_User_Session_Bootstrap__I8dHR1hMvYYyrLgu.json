    {
      "parameters": {
        "jsCode": "const envelope = $('Recover user_id').item.json;\nconst raw      = $input.first().json;\n\n// Si existe sesión en DB, usarla como fuente de verdad\n// Si no existe, crear una nueva con valores por defecto\nconst existingSession = Array.isArray(raw) ? raw[0] : (raw?.id ? raw : null);\n\nlet sessionData;\n\nif (existingSession) {\n  // ── Sesión existente: respetar el estado real de DB ──────────────\n  // NO sobreescribir current_step con el del envelope — DB manda\n  sessionData = {\n    session_id:         existingSession.id,\n    current_step:       existingSession.current_step       ?? 'idle',\n    is_expired:         existingSession.is_expired         ?? false,\n    active_service_id:  existingSession.active_service_id  ?? null,\n    active_provider_id: existingSession.active_provider_id ?? null,\n    active_patient_id:  existingSession.active_patient_id  ?? null,\n    pending_slot_start: existingSession.pending_slot_start ?? null,\n    pending_slot_end:   existingSession.pending_slot_end   ?? null,\n    pending_context:    existingSession.pending_context    ?? {},\n    last_interaction_at: existingSession.last_interaction_at ?? null\n  };\n} else {\n  // ── Sesión nueva: crear con valores limpios ───────────────────────\n  sessionData = {\n    session_id:         null,\n    current_step:       'idle',\n    is_expired:         false,\n    active_service_id:  null,\n    active_provider_id: null,\n    active_patient_id:  null,\n    pending_slot_start: null,\n    pending_slot_end:   null,\n    pending_context:    {},\n    last_interaction_at: null\n  };\n}\n\nreturn [{ json: {\n  ...envelope,\n  user: { ...envelope.user },\n  patient: { active_patient_id: sessionData.active_patient_id },\n  session: sessionData,\n  _user_row: undefined\n}}];"
      },
