    {
      "parameters": {
        "jsCode": "\n// ── CF-15 · Calcular ventanas de tiempo para recordatorios ────────────────\n// Corre cada 15 min. Ventanas amplias (±30 min) + reminder_Xh_sent=false\n// garantizan que nunca se pierda una cita aunque el cron falle una vez.\n\nconst now = new Date();\n\n// Ventana 24h: citas que empiezan entre ahora+23.5h y ahora+24.5h\nconst w24_start = new Date(now.getTime() + 23.5 * 3600_000).toISOString();\nconst w24_end   = new Date(now.getTime() + 24.5 * 3600_000).toISOString();\n\n// Ventana 2h: citas que empiezan entre ahora+1h45m y ahora+2h15m\nconst w2_start  = new Date(now.getTime() + 105 * 60_000).toISOString();\nconst w2_end    = new Date(now.getTime() + 135 * 60_000).toISOString();\n\nreturn [{ json: { now: now.toISOString(), w24_start, w24_end, w2_start, w2_end } }];\n"
      },
      "id": "3b25c536-d19a-4ed2-8450-38ca8df99859",
      "name": "Calcular ventanas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1440,
        400
      ]
    },
    {
      "parameters": {
        "url": "=https://sfybvsgworojwobdrnss.supabase.co/rest/v1/appointments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,tenant_id,user_id,patient_id,service_id,start_at,end_at,status,calendar_event_id,reminder_24h_sent,reminder_2h_sent,patients(full_name),services(name,duration_minutes)"
            },
            {
              "name": "and",
              "value": "=(start_at.gte.{{$json.w24_start}},start_at.lte.{{$json.w24_end}})"
            },
            {
              "name": "status",
              "value": "=in.(reserved,confirmed)"
            },
            {
              "name": "reminder_24h_sent",
              "value": "=eq.false"
            },
            {
              "name": "limit",
              "value": "50"
            }
