        "jsCode": "\n// Fusionar contexto de la cita con datos del tenant\nconst ctx    = $('Prep Reminder Item').item.json;\nconst raw    = $input.first().json;\nconst tenant = Array.isArray(raw) ? raw[0] : (raw?.id ? raw : {});\nreturn [{\n  json: {\n    ...ctx,\n    _tenant_name:     tenant.name             ?? 'la clínica',\n    _tenant_evo:      tenant.evo_instance_name ?? null,\n    _tenant_timezone: tenant.timezone          ?? 'America/Mexico_City',\n    _tenant_active:   (tenant.status ?? 'active') === 'active',\n  }\n}];\n"
