    {
      "parameters": {
        "jsCode": "\n// ── CF-15 · Resolver mensaje final del recordatorio ───────────────────────\n// Si GROQ respondió bien → usar. Si no → usar base determinístico.\n\nconst ctx      = $('Build & Send Reminder').item.json;\nconst groqResp = $input.first().json;\n\nlet aiText = null;\ntry {\n  aiText = String(groqResp?.choices?.[0]?.message?.content ?? '').trim();\n} catch (_) {}\n\n// Validar que el mensaje de GROQ tenga sentido:\n// debe contener el nombre del paciente y ser razonablemente largo\nconst namePresent = ctx._patient_name && aiText?.includes(ctx._patient_name.split(' ')[0]);\nconst isValid     = aiText && aiText.length >= 30 && namePresent;\n\nconst finalBody = isValid ? aiText : ctx._base_message;\n\nreturn [{\n  json: {\n    ...ctx,\n    _groq_messages: undefined,\n    _final_message: finalBody\n  }\n}];\n"
      },
      "id": "ddd9d5b3-f43d-40b0-a7da-ace94b85efce",
      "name": "Resolve Mensaje Final",
