    {
      "parameters": {
        "jsCode": "\n// Eliminar los {} vacíos que n8n genera cuando un Code devuelve []\n// y deduplicar por ID para evitar doble recordatorio a la misma cita\nconst seen = new Set();\nconst items = $input.all()\n  .map(i => i.json)\n  .filter(j => j && j.id && j._reminder_type)  // solo objetos reales de cita\n  .filter(j => {\n    const key = `${j.id}_${j._reminder_type}`;\n    if (seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  });\n\nif (items.length === 0) {\n  return [{ json: { _no_items: true } }];\n}\n\nreturn items.map(j => ({ json: j }));\n"
      },
