    },
    {
      "parameters": {
        "jsCode": "\n// Todo el contexto ya está en $input gracias a la cadena de Enrich\nconst ctx = $('Enrich con Settings').item.json;\nconst raw = $input.first().json;  // GET User response\nconst user = Array.isArray(raw) ? raw[0] : (raw?.id ? raw : {});\n\nconst waNumber    = user?.wa_number    ?? null;\nconst evoInstance = ctx._tenant_evo   ?? null;\n\n// Si no hay número o instancia, marcar para saltarse el envío\nif (!waNumber || !evoInstance || !ctx._bot_enabled || !ctx._tenant_active) {\n  return [{\n    json: {\n      ...ctx,\n      _wa_number:    waNumber,\n      _evo_instance: evoInstance,\n      _skip_send:    true,\n      _skip_reason:  !ctx._tenant_active ? 'tenant_paused'\n                   : !ctx._bot_enabled ? 'bot_disabled'\n                   : !waNumber ? 'no_wa_number'\n                   : 'no_evo_instance'\n    }\n  }];\n}\n\nconst tz  = ctx._tenant_timezone ?? 'America/Mexico_City';\nconst dt  = new Date(ctx._start_at);\nconst fmt = dt.toLocaleString('es-MX', {\n  timeZone: tz, weekday: 'long', day: 'numeric',\n  month: 'long', hour: '2-digit', minute: '2-digit', hour12: true\n});\n\nconst clinicName  = ctx._tenant_name;\nconst patientName = ctx._patient_name;\nconst serviceName = ctx._service_name;\nconst clinicPhone = ctx._phone_contact;\n\nconst baseMsg = ctx._reminder_type === '24h'\n  ? `Hola ${patientName} 👋 Te recordamos que *mañana* tienes cita de *${serviceName}* en *${clinicName}*.\\n\\n📅 ${fmt}\\n\\nSi necesitas cancelar o reagendar escribe *cancelar* o *reagendar*.`\n  : `Hola ${patientName} ⏰ Tu cita de *${serviceName}* en *${clinicName}* es *en 2 horas*.\\n\\n📅 ${fmt}\\n\\n¡Te esperamos! 😊`;\n\nconst systemPrompt =\n  `Eres el asistente de ${clinicName} redactando un recordatorio de cita por WhatsApp. ` +\n  `Humaniza el siguiente mensaje haciéndolo más cálido y natural. REGLAS ESTRICTAS:\\n` +\n  `- Conserva EXACTAMENTE: fecha, hora, nombre del paciente y nombre del servicio\\n` +\n  `- NO agregues información que no esté en el mensaje original\\n` +\n  `- Máximo 4 líneas + emojis apropiados. Tono: amigable, como una recepcionista real\\n` +\n  (clinicPhone ? `- Puedes mencionar el teléfono ${clinicPhone} como contacto de urgencias\\n` : '') +\n  `- Responde SOLO con el mensaje final, sin explicaciones ni comillas`;\n\nreturn [{\n  json: {\n    ...ctx,\n    _wa_number:      waNumber,\n    _evo_instance:   evoInstance,\n    _skip_send:      false,\n    _base_message:   baseMsg,\n    _fmt_datetime:   fmt,\n    _groq_messages:  [\n      { role: 'system', content: systemPrompt },\n      { role: 'user',   content: baseMsg }\n    ]\n  }\n}];\n"
      },
