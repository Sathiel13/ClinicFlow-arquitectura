      "parameters": {
        "jsCode": "\n// Recibe el item directo de SplitInBatches (la cita con todos sus campos)\n// Extrae los IDs que los siguientes GET nodes necesitan como $json.*\nconst appt = $input.first().json;\nreturn [{\n  json: {\n    // Datos de la cita — se propagan hacia adelante en toda la cadena\n    _appt_id:        appt.id,\n    _tenant_id:      appt.tenant_id,\n    _user_id:        appt.user_id,\n    _patient_id:     appt.patient_id,\n    _service_id:     appt.service_id,\n    _start_at:       appt.start_at,\n    _end_at:         appt.end_at,\n    _reminder_type:  appt._reminder_type,\n    _reminder_field: appt._reminder_field,\n    _patient_name:   appt.patients?.full_name ?? 'Paciente',\n    _service_name:   appt.services?.name      ?? 'tu cita',\n    // IDs para los GETs siguientes\n    tenant_id:       appt.tenant_id,\n    user_id:         appt.user_id,\n  }\n}];\n"
      },
