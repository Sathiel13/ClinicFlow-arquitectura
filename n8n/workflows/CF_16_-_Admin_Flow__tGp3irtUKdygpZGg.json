      "id": "7a090d7d-90d3-42d2-a5fd-582abc8f6d42",
      "name": "Supabase — GET Stats 30d",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        800
      ],
      "credentials": {
