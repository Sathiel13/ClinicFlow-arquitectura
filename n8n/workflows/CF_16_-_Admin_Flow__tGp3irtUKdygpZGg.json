    {
      "parameters": {
        "jsCode": "\n// Construir agenda del día solicitado (hoy o mañana)\nconst envelope  = $('Switch Comando Admin').item.json;\nconst raw       = $input.first().json;\nconst appts     = Array.isArray(raw) ? raw : (raw?.id ? [raw] : []);\nconst cmd       = envelope._admin_cmd;\nconst tz        = envelope.tenant?.timezone ?? 'America/Mexico_City';\nconst label     = cmd === 'agenda_hoy' ? 'Hoy' : 'Mañana';\n\nif (appts.length === 0) {\n  return [{ json: {\n    ...envelope,\n    _outbound: { type: 'text',\n      body: `📅 *Agenda — ${label}*\\n\\nNo hay citas programadas para ${label.toLowerCase()}.` }\n  }}];\n}\n\nconst lines = appts.map((a, i) => {\n  const dt = new Date(a.start_at);\n  const fmt = dt.toLocaleString('es-MX', {\n    timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: true\n  });\n  const patient = a.patients?.full_name ?? 'Paciente';\n  const service = a.services?.name      ?? 'Cita';\n  return `• ${fmt} — *${patient}* (${service})`;\n}).join('\\n');\n\nreturn [{ json: {\n  ...envelope,\n  _outbound: { type: 'text',\n    body: `📅 *Agenda — ${label}* (${appts.length} cita${appts.length > 1 ? 's' : ''})\\n\\n${lines}\\n\\n_Escribe *ayuda* para ver más opciones._`\n  }\n}}];\n"
      },
