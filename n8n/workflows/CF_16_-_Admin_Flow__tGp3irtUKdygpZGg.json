    {
      "parameters": {
        "jsCode": "\n// ── CF-16 · Preparar contexto y prompt para clasificar comando admin ────────\nconst envelope   = $input.first().json;\nconst msgText    = String(envelope.message?.text ?? '').trim();\nconst clinicName = envelope.tenant?.name ?? 'la clínica';\nconst userName   = envelope.user?.wa_name ?? 'Admin';\n\n// Detectar si es la primera vez (comando implícito → menú de ayuda)\nconst isFirstAccess = !msgText ||\n  ['admin', '#admin', 'panel', 'administrar'].includes(msgText.toLowerCase().trim());\n\nif (isFirstAccess) {\n  return [{\n    json: {\n      ...envelope,\n      _admin_cmd: 'ayuda',\n      _msg_text:  msgText,\n      _groq_messages: null\n    }\n  }];\n}\n\nconst systemPrompt =\n  `Eres un clasificador de comandos para el panel de administración de \"${clinicName}\". ` +\n  `Clasifica el mensaje del administrador en UNO de estos comandos:\\n\\n` +\n  `- agenda_hoy: ver citas de hoy\\n` +\n  `- agenda_manana: ver citas de mañana\\n` +\n  `- pausar: pausar o desactivar el bot\\n` +\n  `- activar: activar o reanudar el bot\\n` +\n  `- estado: ver estado del sistema, estadísticas, resumen\\n` +\n  `- pacientes: ver lista de últimos pacientes registrados\\n` +\n  `- ayuda: mostrar menú de ayuda o comandos disponibles\\n\\n` +\n  `Responde ÚNICAMENTE con JSON válido sin backticks:\\n` +\n  `{\"cmd\": \"<comando>\", \"confidence\": 0.0}`;\n\nreturn [{\n  json: {\n    ...envelope,\n    _admin_cmd: null,\n    _msg_text:  msgText,\n    _groq_messages: [\n      { role: 'system', content: systemPrompt },\n      { role: 'user',   content: msgText }\n    ]\n  }\n}];\n"
      },
