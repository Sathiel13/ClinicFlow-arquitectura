    {
      "parameters": {
        "jsCode": "\n// Parsear respuesta GROQ y resolver comando\nconst envelope = $('Build Admin Context').item.json;\nconst groqResp = $input.first().json;\n\n// Si ya viene con _admin_cmd (ej: 'ayuda' por first access) → pasar directo\nif (envelope._admin_cmd) {\n  return [{ json: { ...envelope, _groq_messages: undefined } }];\n}\n\nlet cmd = 'ayuda';\nlet confidence = 0;\n\ntry {\n  const content = String(groqResp?.choices?.[0]?.message?.content ?? '');\n  const cleaned = content.replace(/```json|```/g, '').trim();\n  const parsed  = JSON.parse(cleaned);\n  cmd        = String(parsed?.cmd ?? 'ayuda').toLowerCase().trim();\n  confidence = Number(parsed?.confidence ?? 0);\n} catch (_) {}\n\nconst validCmds = ['agenda_hoy','agenda_manana','pausar','activar','estado','pacientes','ayuda'];\nif (!validCmds.includes(cmd) || confidence < 0.6) cmd = 'ayuda';\n\nreturn [{ json: { ...envelope, _admin_cmd: cmd, _groq_messages: undefined } }];\n"
      },
