    {
      "parameters": {
        "jsCode": "\n// Construir reporte de estado del sistema\nconst envelope  = $('Switch Comando Admin').item.json;\nconst raw       = $input.first().json;\nconst appts     = Array.isArray(raw) ? raw : (raw?.id ? [raw] : []);\nconst settings  = envelope.tenant?.settings ?? {};\nconst botStatus = settings.is_bot_enabled ? '🟢 Activo' : '🔴 Pausado';\nconst clinicName = envelope.tenant?.name ?? 'Clínica';\n\n// Calcular estadísticas de los últimos 30 días\nconst now = new Date();\nconst stats = appts.reduce((acc, a) => {\n  acc.total++;\n  if (a.status === 'reserved' || a.status === 'confirmed') acc.activas++;\n  if (a.status === 'cancelled') acc.canceladas++;\n  const start = new Date(a.start_at);\n  if (start > now) acc.proximas++;\n  return acc;\n}, { total: 0, activas: 0, canceladas: 0, proximas: 0 });\n\nconst lines = [\n  `🏥 *${clinicName}*`,\n  `🤖 Bot: ${botStatus}`,\n  ``,\n  `📊 *Últimos 30 días*`,\n  `• Total citas: ${stats.total}`,\n  `• Activas/confirmadas: ${stats.activas}`,\n  `• Canceladas: ${stats.canceladas}`,\n  `• Próximas: ${stats.proximas}`,\n  ``,\n  `_Escribe *ayuda* para ver más opciones._`\n].join('\\n');\n\nreturn [{ json: { ...envelope, _outbound: { type: 'text', body: lines } } }];\n"
      },
