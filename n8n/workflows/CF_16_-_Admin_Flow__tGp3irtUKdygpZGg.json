        "jsCode": "\n// Recuperar resultado de la verificación de admin\nconst envelope = $('Execute Workflow Trigger').first().json;\nconst raw = $input.first().json;\nconst rows = Array.isArray(raw) ? raw : (raw?.id ? [raw] : []);\nconst isAdmin = rows.length > 0 && rows[0]?.is_active === true;\n\nreturn [{ json: { ...envelope, _is_admin: isAdmin, _admin_row: rows[0] ?? null } }];\n"
