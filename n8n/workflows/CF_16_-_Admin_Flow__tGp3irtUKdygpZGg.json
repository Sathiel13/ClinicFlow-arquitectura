    {
      "parameters": {
        "jsCode": "\n// Mostrar últimos pacientes registrados\nconst envelope = $('Switch Comando Admin').item.json;\nconst raw      = $input.first().json;\nconst patients = Array.isArray(raw) ? raw : (raw?.id ? [raw] : []);\n\nif (patients.length === 0) {\n  return [{ json: {\n    ...envelope,\n    _outbound: { type: 'text', body: '👥 No hay pacientes registrados aún.' }\n  }}];\n}\n\nconst lines = patients.map((p, i) =>\n  `• ${p.full_name}${p.phone ? ` — ${p.phone}` : ''}`\n).join('\\n');\n\nreturn [{ json: {\n  ...envelope,\n  _outbound: { type: 'text',\n    body: `👥 *Últimos pacientes (${patients.length})*\\n\\n${lines}\\n\\n_Escribe *ayuda* para ver más opciones._`\n  }\n}}];\n"
      },
