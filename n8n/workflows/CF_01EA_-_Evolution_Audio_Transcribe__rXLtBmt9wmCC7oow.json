    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst base64 = item.json._audio_base64;\nconst mime   = item.json._audio_mime_type ?? 'audio/ogg';\nconst ext    = item.json._audio_file_ext ?? 'ogg';\n\nif (!base64) {\n  throw new Error('No se encontró _audio_base64');\n}\n\nitem.binary = item.binary ?? {};\nitem.binary.data = {\n  data: base64,\n  mimeType: mime,\n  fileName: `audio.${ext}`,\n};\n\nreturn [item];"
      },
