  "nodes": [
    {
      "parameters": {},
      "id": "22af25d3-84ba-436c-a21a-9e9158eb35c8",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -688,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Resolver audio desde el payload crudo de Evolution.\n// Estrategia:\n// 1) detectar audio/ptt\n// 2) si viene base64, preferir file upload a Groq (más robusto)\n// 3) si solo viene URL, usar el parámetro multipart `url`\n// 4) si no hay fuente utilizable, salir sin romper la ruta principal\n\nconst item = $input.first().json;\nconst body = item._raw_body ?? item.body ?? {};\nconst data = body?.data ?? {};\nconst msg  = data?.message ?? {};\nconst messageType = String(data?.messageType ?? '');\n\nconst audioMsg =\n  msg?.audioMessage ??\n  msg?.pttMessage ??\n  msg?.documentWithCaptionMessage?.message?.audioMessage ??\n  null;\n\nconst mimeType =\n  audioMsg?.mimetype ??\n  audioMsg?.mimeType ??\n  data?.mimetype ??\n  'audio/ogg';\n\nconst mediaUrl =\n  audioMsg?.url ??\n  audioMsg?.mediaUrl ??\n  audioMsg?.downloadUrl ??\n  audioMsg?.directUrl ??\n  data?.mediaUrl ??\n  data?.url ??\n  null;\n\nlet base64Audio =\n  audioMsg?.base64 ??\n  audioMsg?.fileBase64 ??\n  data?.base64 ??\n  data?.mediaBase64 ??\n  null;\n\nif (typeof base64Audio === 'string' && base64Audio.startsWith('data:')) {\n  const comma = base64Audio.indexOf(',');\n  if (comma > -1) base64Audio = base64Audio.slice(comma + 1);\n}\n\nconst prompt =\n  'Audio de WhatsApp en español de pacientes de una clínica dental. ' +\n  'Transcribe con ortografía clara y conserva nombres propios, servicios y horarios.';\n\nlet sourceKind = null;\nif (typeof base64Audio === 'string' && base64Audio.length > 100) {\n  sourceKind = 'base64';\n} else if (typeof mediaUrl === 'string' && mediaUrl.startsWith('http')) {\n  sourceKind = 'url';\n}\n\nconst extByMime = {\n  'audio/ogg': 'ogg',\n  'audio/opus': 'ogg',\n  'audio/webm': 'webm',\n  'audio/mpeg': 'mp3',\n  'audio/mp3': 'mp3',\n  'audio/mp4': 'mp4',\n  'audio/x-m4a': 'm4a',\n  'audio/m4a': 'm4a',\n  'audio/wav': 'wav',\n  'audio/x-wav': 'wav'\n};\n\nconst fileExt = extByMime[mimeType] ?? 'ogg';\n\nreturn [{\n  json: {\n    ...item,\n    _audio_message_type: messageType,\n    _audio_source_kind: sourceKind,\n    _audio_url: sourceKind === 'url' ? mediaUrl : null,\n    _audio_base64: sourceKind === 'base64' ? base64Audio : null,\n    _audio_mime_type: mimeType,\n    _audio_file_ext: fileExt,\n    _audio_prompt: prompt,\n    _audio_transcription_error: sourceKind ? null : 'missing_audio_source'\n  }\n}];"
      },
