    {
      "parameters": {
        "jsCode": "\n// Evolution devuelve { base64: \"...\", mediaType: \"audio\" } o similar\nconst source   = $('Preparar fuente de audio').item.json;\nconst evoResp  = $input.first().json;\n\n// Intentar extraer base64 de la respuesta de Evolution\nlet b64 = null;\ntry {\n  b64 = evoResp?.base64 ?? evoResp?.data?.base64 ?? null;\n  // Quitar prefijo data:... si viene\n  if (typeof b64 === 'string' && b64.startsWith('data:')) {\n    b64 = b64.slice(b64.indexOf(',') + 1);\n  }\n} catch (_) {}\n\nconst hasB64 = typeof b64 === 'string' && b64.length > 100;\n\nreturn [{\n  json: {\n    ...source,\n    // Sobreescribir con base64 real si Evolution lo proveyó\n    _audio_source_kind: hasB64 ? 'base64' : source._audio_source_kind,\n    _audio_base64:      hasB64 ? b64      : source._audio_base64,\n    // Conservar URL como último recurso\n    _evo_b64_ok: hasB64,\n  }\n}];\n"
      },
      "id": "024dcf7d-7d1c-4453-bf07-254d5c0faf51",
      "name": "Inject base64 de Evolution",
