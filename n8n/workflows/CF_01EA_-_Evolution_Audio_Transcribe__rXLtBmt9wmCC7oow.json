    {
      "parameters": {
        "jsCode": "// Reescribir el payload para que CF-01BE Normalize lo trate como texto normal.\nconst source = $('Preparar fuente de audio').item.json;\nconst stt    = $input.first().json ?? {};\n\nconst text =\n  (typeof stt?.text === 'string' && stt.text.trim()) ? stt.text.trim() :\n  (typeof stt === 'string' && stt.trim()) ? stt.trim() :\n  null;\n\nconst body = JSON.parse(JSON.stringify(source._raw_body ?? {}));\nbody.data = body.data ?? {};\nbody.data.messageType = 'conversation';\nbody.data.message = {\n  ...(body.data.message ?? {}),\n  conversation: text ?? ''\n};\n\nreturn [{\n  json: {\n    ...source,\n    _raw_body: body,\n    _audio_transcription: text,\n    _audio_transcription_error: text ? null : (source._audio_transcription_error ?? 'transcription_empty'),\n    _audio_transcription_meta: stt,\n    _original_message_type: source._audio_message_type ?? 'audio'\n  }\n}];"
      },
