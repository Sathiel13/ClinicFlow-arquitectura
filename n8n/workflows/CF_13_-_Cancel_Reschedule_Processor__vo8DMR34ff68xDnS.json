        "jsCode": "const envelope = $('Detectar acción').item.json;\nconst raw      = $input.first().json;\nconst appt     = Array.isArray(raw) ? raw[0] : raw;\n\nif (!appt?.id || !appt?.calendar_event_id) {\n  return [{ json: { ...envelope, _cr_error: 'appointment_not_found' } }];\n}\n\nreturn [{ json: {\n  ...envelope,\n  _cr_booking_uid: appt.calendar_event_id,\n  _cr_appt: appt\n} }];"
