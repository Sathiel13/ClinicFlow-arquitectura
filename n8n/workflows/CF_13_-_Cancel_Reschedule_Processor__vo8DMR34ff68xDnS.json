    {
      "parameters": {
        "jsCode": "const envelope = $('Detectar acción').item.json;\nconst items    = $input.all().map(i => i.json);\nconst action   = envelope._cr_action;\n\nconst appts = items.flatMap(item => {\n  if (Array.isArray(item)) return item;\n  if (item?.id && item?.start_at) return [item];\n  return [];\n}).filter(a => a.id && a.start_at);\n\nif (appts.length === 0) {\n  return [{\n    json: {\n      ...envelope,\n      session: { ...envelope.session, current_step: 'idle', pending_context: {} },\n      _session_update: { current_step: 'idle', pending_context: {} },\n      _outbound: {\n        type:'text',\n        body:'ℹ️ No encontré citas próximas para tu número.\\n\\nEscribe *hola* para volver al menú.'\n      }\n    }\n  }];\n}\n\nconst tz       = envelope.tenant?.timezone ?? 'America/Mexico_City';\nconst verb     = action === 'cancel_lookup' ? 'cancelar' : 'reagendar';\nconst nextStep = action === 'cancel_lookup' ? 'select_cancel_appointment' : 'select_reschedule_appointment';\n\nconst catalogText = appts.map((a, i) => {\n  const dt  = new Date(a.start_at);\n  const fmt = dt.toLocaleString('es-MX', {\n    timeZone: tz,\n    weekday:'short',\n    month:'short',\n    day:'numeric',\n    hour:'2-digit',\n    minute:'2-digit',\n    hour12:true\n  });\n  // Nombre del paciente desde el JOIN (patients.full_name)\n  const patName = a.patients?.full_name ?? null;\n  const patLabel = patName ? ` — ${patName}` : '';\n  return `• ${i + 1}. ${fmt}${patLabel}`;\n}).join('\\n');\n\nconst intro = envelope._appointment_selection_invalid\n  ? '⚠️ No pude identificar la cita elegida.\\n\\n'\n  : '';\n\nconst pendingContext = {\n  appointments_for_action: appts.map(a => ({\n    id: a.id,\n    start_at: a.start_at,\n    calendar_event_id: a.calendar_event_id,\n    status: a.status,\n    patient_name: a.patients?.full_name ?? null\n  })),\n  appointments_action: action\n};\n\nreturn [{\n  json: {\n    ...envelope,\n    session: { ...envelope.session, current_step: nextStep, pending_context: pendingContext },\n    _session_update: { current_step: nextStep, pending_context: pendingContext },\n    _outbound: {\n      type: 'text',\n      body: `${intro}¿Cuál cita deseas ${verb}?\\n\\n*Citas activas*\\n${catalogText}\\n\\n_Responde con el número de la cita._`\n    }\n  }\n}];"
      },
