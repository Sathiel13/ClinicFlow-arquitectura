    {
      "parameters": {
        "jsCode": "const e = $('Recover appointment').item.json;\n\nreturn [{\n  json: {\n    ...e,\n    patient: {\n      ...(e.patient ?? {}),\n      active_patient_id: e._cr_appt?.patient_id ?? e.patient?.active_patient_id ?? null\n    },\n    session: {\n      ...e.session,\n      current_step: 'select_slot',\n      active_service_id: e._cr_appt?.service_id ?? e.session?.active_service_id ?? null,\n      active_patient_id: e._cr_appt?.patient_id ?? e.session?.active_patient_id ?? null,\n      pending_context: {\n        reschedule_uid: e._cr_booking_uid,\n        reschedule_appt_id: e._cr_appt.id\n      }\n    },\n    _session_update: {\n      current_step: 'select_slot',\n      active_service_id: e._cr_appt?.service_id ?? e.session?.active_service_id ?? null,\n      active_patient_id: e._cr_appt?.patient_id ?? e.session?.active_patient_id ?? null,\n      pending_context: {\n        reschedule_uid: e._cr_booking_uid,\n        reschedule_appt_id: e._cr_appt.id\n      }\n    }\n  }\n}];"
      },
