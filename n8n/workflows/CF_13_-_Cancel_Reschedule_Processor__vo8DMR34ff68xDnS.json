    {
      "parameters": {
        "jsCode": "const e = $('Recover appointment').item.json;\n\nconst tz  = e.tenant?.timezone ?? 'America/Mexico_City';\nconst dt  = e._cr_appt?.start_at ? new Date(e._cr_appt.start_at) : null;\nconst fmt = dt\n  ? dt.toLocaleString('es-MX', {\n      timeZone: tz,\n      weekday: 'long',\n      day: 'numeric',\n      month: 'long',\n      hour: '2-digit',\n      minute: '2-digit',\n      hour12: true\n    })\n  : null;\n\nconst deterministicBody = fmt\n  ? `✅ Tu cita del *${fmt}* ha sido cancelada correctamente.\\n\\nSi necesitas agendar una nueva cita, escribe *hola*. 😊`\n  : `✅ Tu cita ha sido cancelada correctamente.\\n\\nSi necesitas agendar una nueva cita, escribe *hola*. 😊`;\n\nreturn [{\n  json: {\n    ...e,\n    session: {\n      ...e.session,\n      current_step: 'idle',\n      pending_context: {},\n      active_service_id: null\n    },\n    _cr_appt: undefined,\n    _cr_booking_uid: undefined,\n    _cr_action: undefined,\n    _fallback_outbound: { type: 'text', body: deterministicBody },\n    _outbound: { type: 'text', body: deterministicBody },\n    _humanizer: {\n      operation: 'cancel_confirmation',\n      clinic_name: e.tenant?.name ?? 'la clínica',\n      user_name: e.user?.wa_name ?? 'Paciente',\n      formatted_datetime: fmt ?? '',\n      base_message: deterministicBody\n    }\n  }\n}];"
      },
      "id": "f192b687-37be-4808-9be7-6c73557c3790",
      "name": "Build Cancelación OK",
