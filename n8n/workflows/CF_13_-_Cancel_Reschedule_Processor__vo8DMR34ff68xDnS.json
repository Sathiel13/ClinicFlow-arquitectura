    {
      "parameters": {},
      "id": "db856a30-26af-4758-914a-ebbc76fa22f9",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -1808,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const envelope    = $input.first().json;\nconst interactive = envelope.message?.interactive ?? {};\nconst text        = String(envelope.message?.text ?? '').toLowerCase().trim();\n\nlet action        = null;\nlet appointmentId = null;\n\nif (interactive.id?.startsWith('CF:CANCEL:')) {\n  action        = 'cancel';\n  appointmentId = interactive.id.replace('CF:CANCEL:', '');\n} else if (interactive.id?.startsWith('CF:RESCH:')) {\n  action        = 'reschedule';\n  appointmentId = interactive.id.replace('CF:RESCH:', '');\n} else if (envelope._cr_appointment_id) {\n  action        = envelope._cr_action ?? null;\n  appointmentId = envelope._cr_appointment_id;\n} else if (['cancelar','cancela','cancel','baja','eliminar cita'].some(w => text.includes(w))) {\n  action = 'cancel_lookup';\n} else if (['reagendar','reprogramar','cambiar cita','mover cita','reschedule'].some(w => text.includes(w))) {\n  action = 'reschedule_lookup';\n}\n\nif (!action) {\n  return [{ json: { ...envelope, _cr_error: 'no_action_detected' } }];\n}\n\nreturn [{ json: { ...envelope, _cr_action: action, _cr_appointment_id: appointmentId ?? null } }];"
      },
