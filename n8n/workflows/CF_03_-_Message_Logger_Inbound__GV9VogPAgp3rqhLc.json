        "jsCode": "const envelope = $input.first().json;\n\nconst record = {\n  tenant_id:  envelope.tenant?.tenant_id ?? null,\n  user_wa:    envelope.user?.wa_number,\n  direction:  'inbound',\n  message_id: envelope.message?.message_id ?? null,\n  payload: {\n    channel:     envelope._channel ?? 'unknown',\n    type:        envelope.message?.type,\n    text:        envelope.message?.text,\n    interactive: envelope.message?.interactive,\n    timestamp:   envelope.message?.timestamp\n  }\n};\n\nreturn [{ json: { _log_record: record, ...envelope } }];"
