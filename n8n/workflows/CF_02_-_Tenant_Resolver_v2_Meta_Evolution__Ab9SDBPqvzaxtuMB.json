    {
      "parameters": {
        "jsCode": "// Construye Envelope final con tenant + settings completos\nconst prev     = $('¿Tenant activo?').item.json;\nconst t        = prev._tenant_row;\nconst settRows = $input.first().json;\nconst settings = (Array.isArray(settRows) ? settRows[0] : settRows) ?? {};\n\nconst envelope = {\n  tenant: {\n    tenant_id:           t.id,\n    wa_phone_number_id:  t.wa_phone_number_id  ?? null,\n    evo_instance_name:   t.evo_instance_name   ?? null,\n    calendar_id:         t.calendar_id         ?? null,\n    timezone:            t.timezone            ?? 'America/Mexico_City',\n    name:                t.name,\n    settings: {\n      welcome_message:        settings.welcome_message        ?? null,\n      about_text:             settings.about_text             ?? null,\n      google_maps_url:        settings.google_maps_url        ?? null,\n      phone_contact:          settings.phone_contact          ?? null,\n      faq_json:               settings.faq_json               ?? [],\n      assistant_prompt:       settings.assistant_prompt       ?? null,\n      working_hours_json:     settings.working_hours_json     ?? {},\n      cancellation_policy:    settings.cancellation_policy    ?? null,\n      booking_buffer_minutes: settings.booking_buffer_minutes ?? 0,\n      calcom_event_type_id:   settings.calcom_event_type_id   ?? null,\n      is_bot_enabled:         settings.is_bot_enabled         ?? true\n    }\n  },\n  user:    prev.user,\n  patient: prev.patient,\n  session: prev.session,\n  message: prev.message,\n  routing: prev.routing,\n  _channel: prev._channel ?? 'meta',\n  meta:    prev.meta\n};\n\nreturn [{ json: envelope }];"
      },
