    {
      "parameters": {
        "jsCode": "// PostgREST devuelve array, pero n8n puede desempaquetarlo automáticamente.\n// Manejamos ambos casos.\nconst envelope   = $('Execute Workflow Trigger').item.json;\nconst raw        = $input.first().json;\n\n// Si n8n ya desempaquetó → raw es el objeto directo\n// Si llegó como array → tomamos el primer elemento\nconst tenant = Array.isArray(raw) ? (raw[0] ?? null) : (raw?.id ? raw : null);\n\nreturn [{\n  json: {\n    ...envelope,\n    _tenant_row:    tenant,\n    _tenant_found:  tenant !== null,\n    _tenant_active: tenant?.status === 'active'\n  }\n}];"
      },
