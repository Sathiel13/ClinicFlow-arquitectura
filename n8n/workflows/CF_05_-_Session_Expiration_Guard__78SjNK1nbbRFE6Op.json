    {
      "parameters": {
        "jsCode": "const envelope = $input.first().json;\nconst session  = envelope.session;\nif (!session?.session_id) return [{ json: { ...envelope, _expired: false } }];\nconst last    = new Date(session.last_interaction_at ?? Date.now());\nconst mins    = (Date.now() - last) / 60000;\nconst expired = mins > 30 && session.current_step !== 'idle';\nreturn [{ json: { ...envelope, _expired: expired, _minutes_inactive: Math.round(mins) } }];"
      },
      "id": "9f01661f-bb04-4ff2-b7bf-730e8197fa1c",
      "name": "Evaluar expiración",
