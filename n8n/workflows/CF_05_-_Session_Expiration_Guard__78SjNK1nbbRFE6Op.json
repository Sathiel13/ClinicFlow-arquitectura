    {
      "parameters": {
        "jsCode": "const envelope = $('Evaluar expiración').item.json;\nconst welcome  = envelope.tenant?.settings?.welcome_message ?? 'Hola de nuevo 👋';\nreturn [{ json: {\n  ...envelope,\n  session: { ...envelope.session, current_step: 'idle', is_expired: true,\n    active_service_id: null, pending_slot_start: null, pending_slot_end: null, pending_context: {} },\n  _outbound: {\n    type: 'buttons',\n    body: '⏰ Tu sesión anterior expiró.\\n\\n' + welcome,\n    buttons: [\n      { id: 'CF:MENU',  title: '📋 Ver menú' },\n      { id: 'CF:START', title: '🔄 Empezar'  }\n    ]\n  }\n}}];"
